{
  "name": "bmtnews-daily-dispatcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --include-runtime false",
    "types:check": "wrangler types --include-runtime false --check",
    "typecheck": "tsc --noEmit",
    "test": "GITHUB_DISPATCH_TOKEN=test-token RECOVERY_CHECK_TOKEN=test-check-token PAGES_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/test vitest run",
    "check": "npm run types:check && npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "26.1.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
